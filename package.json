{
  "name": "iceruca",
  "private": true,
  "version": "0.1.0",
  "description": "交通系ICカードの利用条件を公式情報から確認するWebアプリ",
  "license": "MIT",
  "author": "GawaDev",
  "homepage": "https://iceruca.onrender.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GawaDev/ICeRuCa.git"
  },
  "bugs": {
    "url": "https://github.com/GawaDev/ICeRuCa/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "data:rail": "node scripts/build-rail-data.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:screenshots": "npm run build && node scripts/capture-pwa-screenshots.mjs && npm run build",
    "license:check": "license-checker-rseidelsohn --production --excludePackages iceruca@0.1.0 --onlyAllow \"MIT;MIT*;ISC;BSD-2-Clause;Apache-2.0;0BSD;(MIT OR CC0-1.0);(MPL-2.0 OR Apache-2.0)\""
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "dompurify": "^3.4.15",
    "leaflet": "^1.9.4",
    "marked": "^18.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
